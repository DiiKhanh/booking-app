# ── Stage 1: Build ───────────────────────────────────────────────────
FROM golang:1.21-alpine AS builder
WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o /worker ./cmd/worker

# ── Stage 2: Runtime (distroless) ────────────────────────────────────
FROM gcr.io/distroless/static-debian12
COPY --from=builder /worker /worker
ENTRYPOINT ["/worker"]
