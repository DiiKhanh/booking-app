# StayEase Backend — Production Environment Variables
# Copy to .env and fill in real values. NEVER commit real secrets.

APP_NAME=stayease-api
HTTP_PORT=8080
ENVIRONMENT=production

# ── PostgreSQL (Supabase connection pooler) ──────────────────────────
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DB_SSLMODE=require

# ── Redis (Upstash — TLS) ─────────────────────────────────────────────
REDIS_URL=rediss://default:[password]@[host].upstash.io:6379
REDIS_ADDR=
REDIS_PASSWORD=

# ── RabbitMQ (CloudAMQP — AMQPS) ─────────────────────────────────────
RABBITMQ_URL=amqps://[user]:[password]@[host].cloudamqp.com/[vhost]

# ── Elasticsearch (Elastic Cloud) ────────────────────────────────────
ELASTICSEARCH_URL=https://[deployment].es.[region].aws.elastic-cloud.com
ELASTICSEARCH_API_KEY=

# ── JWT ───────────────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
JWT_SECRET=replace-with-256-bit-random-secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d

# ── Rate Limiting ─────────────────────────────────────────────────────
RATE_LIMIT_PUBLIC=100
RATE_LIMIT_AUTH=30

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://stayease.vercel.app

# ── OpenTelemetry / Jaeger ────────────────────────────────────────────
OTEL_ENDPOINT=https://your-jaeger-endpoint:4318
OTEL_SERVICE_NAME=stayease-api
JAEGER_ENDPOINT=https://your-jaeger-endpoint:4318
