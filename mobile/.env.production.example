# StayEase Mobile — Production Environment Variables (EAS)
# Set these in eas.json or Expo dashboard secrets.

# API base URL (Railway API service — no trailing slash)
EXPO_PUBLIC_API_URL=https://stayease-api.up.railway.app

# WebSocket URL (wss:// for production)
EXPO_PUBLIC_WS_URL=wss://stayease-api.up.railway.app
